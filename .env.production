VITE_API_BASE_URL=https://api.jedaanihospitals.com/api

# License protection (per-client build lock). The build refuses to run on any
# host other than these (localhost always allowed for smoke tests). The
# watermark is a hidden per-client marker that identifies this build if it leaks.
VITE_LICENSE_DOMAINS=jedaanihospitals.com
VITE_CLIENT_WATERMARK=aljedaani-hospital
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_HYPERPAY_WIDGET_URL= https://eu-prod.oppwa.com/